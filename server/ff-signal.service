[Unit]
Description=Firefighters signaling server (WebSocket)
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/node /opt/ff-signal/signal.mjs
Environment=NODE_PATH=/usr/share/nodejs
Environment=FF_HOST=127.0.0.1
Environment=FF_PORT=8090
Environment=FF_ORIGINS=https://iclimber.github.io
Environment=FF_TURN_SECRET_FILE=/etc/ff-turn/secret
Environment=FF_TURN_URLS=turn:__IP__:3478?transport=udp,turns:__HOST__:443?transport=tcp
# секрет TURN належить групі www-data
DynamicUser=yes
SupplementaryGroups=www-data
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
